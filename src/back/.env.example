DATABASE_URL=postgresql://postgres:postgres@localhost:5432/virtual_tryon

# dev: هدر X-External-User-Id کافیه (فقط برای توسعه) | jwt: توکن Bearer با sub
AUTH_MODE=dev
HOST_JWT_SECRET=change-this-to-a-long-random-secret
HOST_JWT_ALGORITHM=HS256

# minio (پیش‌فرض) | local (فقط برای دموی بدون Docker)
STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=virtual-tryon
